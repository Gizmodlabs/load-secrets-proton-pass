{
  "name": "load-secrets-proton-pass",
  "version": "1.1.0",
  "description": "GitHub Action that loads secrets from Proton Pass vaults via pass:// URIs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts src/cleanup.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist",
    "test": "node --test \"tests/unit/*.test.ts\" \"tests/integration/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/*.test.ts\"",
    "lint": "oxlint src tests",
    "build:check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/http-client": "^2.2.3",
    "@actions/tool-cache": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "oxlint": "^1.73.0",
    "typescript": "^7.0.2"
  }
}
